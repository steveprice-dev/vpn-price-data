{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/steveprice-dev/vpn-price-data/blob/main/schemas/comparison-catalog.schema.json",
  "title": "Automatically validated multi-plan comparison catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feed_type",
    "generated_at",
    "methodology_url",
    "validation_status",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "feed_type": {
      "const": "dovpn_comparison_catalog"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "methodology_url": {
      "const": "https://github.com/steveprice-dev/vpn-price-data/blob/main/methodology/comparison-catalog.md"
    },
    "validation_status": {
      "const": "automated_validated"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "money": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_name",
        "plan_id",
        "plan_name",
        "country_code",
        "currency",
        "observed_at",
        "advertised_monthly_equivalent",
        "upfront_total",
        "paid_months",
        "free_months",
        "service_months",
        "effective_intro_monthly",
        "renewal_total",
        "renewal_period_months",
        "effective_renewal_monthly",
        "refund_days",
        "tax_treatment",
        "promotion_label",
        "promotion_theme",
        "source_url",
        "evidence_sha256",
        "validation_status",
        "freshness_status",
        "billing_type",
        "renewal_total_status",
        "offer_key",
        "upfront_total_status",
        "refund_status",
        "refund_note",
        "materially_changed_at"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "plan_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "plan_name": {
          "type": "string",
          "minLength": 1
        },
        "country_code": {
          "const": "US"
        },
        "currency": {
          "enum": [
            "USD",
            "EUR"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "advertised_monthly_equivalent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "upfront_total": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "paid_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "free_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "service_months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "effective_intro_monthly": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "billing_type": {
          "enum": [
            "recurring_subscription",
            "non_recurring_prepaid",
            "prepaid_optional_auto_renewal",
            "manual_renewal_prepaid"
          ]
        },
        "renewal_total": {
          "$ref": "#/$defs/money"
        },
        "renewal_total_status": {
          "enum": [
            "machine_extracted",
            "derived",
            "not_visible",
            "not_applicable",
            "ambiguous",
            "checkout_observed",
            "derived_from_checkout"
          ]
        },
        "renewal_period_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 120
        },
        "effective_renewal_monthly": {
          "$ref": "#/$defs/money"
        },
        "refund_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tax_treatment": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "promotion_label": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "promotion_theme": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9_]+$"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation_status": {
          "const": "automated_validated"
        },
        "freshness_status": {
          "const": "current"
        },
        "offer_key": {
          "type": "string",
          "pattern": "^[a-z0-9-]+:[a-z0-9-]+:US:(USD|EUR):[a-f0-9]{16}$"
        },
        "upfront_total_status": {
          "enum": [
            "machine_extracted",
            "derived",
            "checkout_observed",
            "derived_from_checkout"
          ]
        },
        "refund_status": {
          "enum": [
            "machine_extracted",
            "derived",
            "checkout_observed",
            "derived_from_checkout",
            "not_visible",
            "not_applicable",
            "ambiguous"
          ]
        },
        "refund_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "materially_changed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
